# ---- server (Render / your host's environment settings) ----
# Port to listen on. Render sets this for you.
PORT=3001
# Only needed if the client is hosted on a DIFFERENT domain (e.g. Vercel).
# Comma-separated, exact origins, no trailing slash.
ALLOWED_ORIGINS=https://your-ludo.vercel.app

# ---- client (build-time, only for a separately hosted client) ----
# Leave unset when the server serves the client (the default, recommended setup).
VITE_SERVER_URL=https://your-ludo-server.onrender.com
